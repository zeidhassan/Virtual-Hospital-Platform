{
  "name": "virtual-hospital-platform",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "predev": "node scripts/ensure-ollama.js",
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" --kill-others \"nodemon server.js\" \"npm run dev --prefix frontend\"",
    "start": "node server.js",
    "refresh": "touch server.js",
    "restart": "pkill -f nodemon; pkill -f vite; npm run dev",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "coverage": "cross-env NODE_ENV=test jest --runInBand --coverage  --collectCoverageFrom='src/{config,controllers,middleware,routes,utils,validators}/**/*.js'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.1",
    "pg": "^8.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1"
  }
}
