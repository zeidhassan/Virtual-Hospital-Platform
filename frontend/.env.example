# Copy this file to .env and fill in your values
# Never commit .env to git

# Backend API base URL
# Left unset on purpose: the app defaults to the relative path '/api', which
# goes through the Vite dev proxy (see vite.config.js) to whichever origin
# actually served the page. A hardcoded absolute URL here gets baked into the
# JS for every visitor — it only works for requests originating from this
# machine, and breaks for anyone else (e.g. sharing the app via ngrok).
# Only set this if your API genuinely lives on a different origin than the
# frontend in your deployment.
# VITE_API_BASE_URL=http://localhost:5000/api

VITE_APP_NAME=HelixaCare
