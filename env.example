# Server
PORT=5000

# DB_MODE: "neon" (cloud connection string) or "local" (discrete credentials)
DB_MODE=local

DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=helixacare_db
DB_PASSWORD=
DB_PORT=5432

# Neon / cloud mode: provide a full connection string instead of the above
DB_URL=

DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=10000

# Required — the server refuses to start without these two
JWT_SECRET=
ENCRYPTION_KEY=

JWT_EXPIRES_IN=1d

# OAuth2 — optional, omit to disable social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000
